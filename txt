def has_two_cube_sums(n):
    if n<=0:
        return False
    
    para=[]
    a=1
    while 2 * a ** 3 <=n:
        rez=n - a ** 3
        
        b=round(rez ** (1/3))
        while (b+1) ** 3 <= rez:
            b+=1
        while b ** 3 > rez:
            b-=1
        if b >= a and b ** 3 == rez:
            para.append((a,b))
            if len(para) >= 2:
                return True
        a+=1
    return False
