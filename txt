from datetime import datetime, timedelta
def how_many_times(time1, time2):
    t1=datetime.strptime(time1,"%Y-%m-%d %H:%M:%S")
    t2=datetime.strptime(time2,"%Y-%m-%d %H:%M:%S")
    
    total = 0
    
    cur = t1.replace(minute=0,second=0,microsecond=0)
    if cur < t1 - timedelta(hours=1):
        cur+= timedelta(hours=1)
    cur = t1.replace(minute=0 if t1.minute < 30 else 30 , second =0 , microsecond = 0)
    
    while cur < t2:
        if cur.minute ==0:
            k = cur.hour % 12
            if k==0:
                k=12
            for i in range(k):
                strike=cur +timedelta(seconds=i)
                if t1<= strike <t2:
                    total +=1
        else:
            if t1 <= cur <t2:
                total +=1
        cur += timedelta(minutes=30)
    return total
