def prime_factors(n):
    result=[]
    d=2
    
    while d*d <=n:
        count =0
        while n%d ==0:
            n//=d
            count+=1
        if count:
            result.append((d,count))
        d+=1 if d==2 else 2
        
    if n>1:
        result.append((n,1))
        
    parts=[]
    for p,e in result :
        parts.append(f"({p}**{e})" if e>1 else f"({p})")
    return "".join(parts)
