def ipv4__parser(ip_addr, mask):
    ip_parts=[int(x) for x in ip_addr.split('.')]
    mask_parts=[int(x) for x in mask.split('.')]
    
    network =[ip_parts[i] & mask_parts[i] for i in range(4)]
    host=[ip_parts[i] & (~mask_parts[i] & 0xFF) for i in range(4)]
    
    return (
    '.'.join(map(str,network)),
    '.'.join(map(str,host)),
    )
